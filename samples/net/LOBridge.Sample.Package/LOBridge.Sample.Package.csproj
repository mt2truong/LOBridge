<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LOBridge.Sample.Package</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolved from nuget.config, which points at ..\..\..\package\nupkg (run package\Pack.ps1 first). -->
    <PackageReference Include="LOBridge.Net" Version="1.0.0" />
  </ItemGroup>

</Project>
