<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LOBridge.ComAdapter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LOBridge.Abstractions\LOBridge.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The early-bound COM types generated from the type library (see samples/net/tools/Generate-Interop.ps1). -->
    <Reference Include="Interop.LOBridge">
      <HintPath>..\..\LOBridge.Sample\lib\Interop.LOBridge.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
