<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LOBridge</RootNamespace>
    <!-- Only Abstractions and ComAdapter are compiled; the default glob would also pick up other folders. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Package identity. The managed assembly is LOBridge.Net.dll, so it does not clash with the native LOBridge.dll. -->
    <PackageId>LOBridge.Net</PackageId>
    <Version>1.0.0</Version>
    <Authors>LOBridge contributors</Authors>
    <Description>.NET 10 access to LibreOffice Writer and Calc through the LOBridge native COM server. Interfaces, a COM adapter, the generated interop types and the native LOBridge.dll.</Description>
    <PackageTags>libreoffice;office;writer;calc;uno;com;docx;xlsx</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mt2truong/LOBridge</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Abstractions\**\*.cs;ComAdapter\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by Pack.ps1 (tlbimp on native/generated/LOBridge.tlb). ComAdapter uses it, the consumer loads it from the package. -->
    <Reference Include="Interop.LOBridge">
      <HintPath>lib\Interop.LOBridge.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <None Include="lib\Interop.LOBridge.dll" Pack="true" PackagePath="lib\net10.0-windows7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built by native\build.ps1. Shipped under build\native and copied next to the consumer's program by build\LOBridge.Net.targets. -->
    <None Include="..\native\bin\LOBridge.dll" Pack="true" PackagePath="build\native\LOBridge.dll" Link="native\LOBridge.dll" />
    <None Include="build\LOBridge.Net.targets" Pack="true" PackagePath="build\LOBridge.Net.targets" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
