<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings shared by every native project in LOBridge (the DLL and the smoke test).
  Override the SDK location from the command line, for example:
    msbuild native\LOBridge.vcxproj /p:Configuration=Release /p:Platform=x64 /p:LibreOfficeSdkDir="D:\LibreOffice\sdk"
-->
<Project ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <NativeRoot>$(MSBuildThisFileDirectory)</NativeRoot>
    <LibreOfficeSdkDir Condition="'$(LibreOfficeSdkDir)' == ''">C:\Program Files\LibreOffice\sdk</LibreOfficeSdkDir>
    <!-- The LibreOffice installation folder: the parent of the sdk folder, which holds program\types. -->
    <LibreOfficeHome>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetFullPath('$(LibreOfficeSdkDir)'))))</LibreOfficeHome>
    <SdkInclude>$(LibreOfficeSdkDir)\include</SdkInclude>
    <SdkLib>$(LibreOfficeSdkDir)\lib</SdkLib>
    <GeneratedDir>$(NativeRoot)generated\</GeneratedDir>
    <UnoHeaderDir>$(GeneratedDir)include\</UnoHeaderDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(NativeRoot)src;$(NativeRoot)src\common;$(NativeRoot)src\uno;$(GeneratedDir);$(UnoHeaderDir);$(SdkInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32;_WIN32;WNT;NOMINMAX;CPPU_ENV=msci;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Midl>
      <TargetEnvironment>X64</TargetEnvironment>
      <ProxyFileName>$(IntDir)LOBridge_p.c</ProxyFileName>
      <DllDataFileName>$(IntDir)dlldata.c</DllDataFileName>
    </Midl>
    <Link>
      <AdditionalLibraryDirectories>$(SdkLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>icppu.lib;icppuhelper.lib;isal.lib;ole32.lib;oleaut32.lib;uuid.lib;advapi32.lib;user32.lib;delayimp.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>sal3.dll;cppu3.dll;cppuhelper3MSC.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>

  <!-- Creates the output folders and generates the UNO C++ headers once, before the IDL is compiled. -->
  <Target Name="LOBridgePrepare" BeforeTargets="Midl">
    <MakeDir Directories="$(GeneratedDir);$(UnoHeaderDir);$(IntDir)common;$(IntDir)uno;$(IntDir)com;$(IntDir)writer;$(IntDir)calc" />
    <Exec Condition="!Exists('$(UnoHeaderDir)com\sun\star\uno\DeploymentException.hpp')"
          Command="&quot;$(LibreOfficeSdkDir)\bin\cppumaker.exe&quot; -O &quot;$(UnoHeaderDir)&quot; &quot;$(LibreOfficeHome)\program\types\offapi.rdb&quot; &quot;$(LibreOfficeHome)\program\types.rdb&quot;" />
  </Target>

</Project>
